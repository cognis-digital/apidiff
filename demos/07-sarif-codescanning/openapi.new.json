{
  "openapi": "3.0.3",
  "info": { "title": "Accounts API", "version": "5.0.0" },
  "paths": {
    "/v1/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "parameters": [
          { "name": "region", "in": "query", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "balance": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
