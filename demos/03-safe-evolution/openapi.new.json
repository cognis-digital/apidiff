{
  "openapi": "3.0.3",
  "info": { "title": "Orders API", "version": "1.5.0" },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          { "name": "status", "in": "query", "required": false,
            "schema": { "type": "string" } },
          { "name": "currency", "in": "query", "required": false,
            "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "total": { "type": "number" },
                    "currency": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}/refunds": {
      "post": {
        "operationId": "createRefund",
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
