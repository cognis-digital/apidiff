{
  "openapi": "3.0.3",
  "info": { "title": "Signup API", "version": "1.0.0" },
  "paths": {
    "/users": {
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string" },
                  "displayName": { "type": "string" },
                  "marketingOptIn": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
